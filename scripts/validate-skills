#!/usr/bin/env bash
# cap 技能族结构 lint —— 可重复回归测试(纯 shell,无依赖)。
# 检查:① 每个 SKILL.md 有合法 frontmatter;② 角色名↔文件↔字典一致;
#       ③ verify checks 名↔文件↔字典一致;④ 关键共享文件存在。
# 用法:bash scripts/validate-skills   (commit 前必跑;退出码 0=通过)
set -u
cd "$(dirname "$0")/.." || exit 2
ROOT="skills"; REF="$ROOT/cap-flow/references"
fail=0
err(){ echo "  ✗ $1"; fail=$((fail+1)); }
ok(){ echo "  ✓ $1"; }
contains_old_skill_name(){
  local value="$1"
  if command -v rg >/dev/null 2>&1; then
    rg -q "$value" "$ROOT" scripts README.md CLAUDE.md --glob '!validate-skills' --glob '!setup-lib.mjs' --glob '!test-setup.mjs'
  else
    grep -R -q --exclude='validate-skills' --exclude='setup-lib.mjs' --exclude='test-setup.mjs' -- "$value" "$ROOT" scripts README.md CLAUDE.md
  fi
}

echo "== 1. 关键共享文件/目录 =="
for p in "$REF/role-routing.md" "$REF/distillation-loop.md" "$REF/runtime-adapters/codex.md" "$REF/progress-protocol.md" "$REF/task-reconnaissance.md" "$REF/harness-action-protocol.md" "$ROOT/cap-flow/scripts/cap-context-guard" "$REF/roles" "$ROOT/cap-test/checks" "$REF/templates/STATE.md" "$REF/templates/PROFILE.md"; do
  [ -e "$p" ] && ok "$p" || err "缺失:$p"
done

echo "== 2. 每个 SKILL.md frontmatter(name + description) =="
for f in "$ROOT"/*/SKILL.md; do
  head -15 "$f" | grep -qE '^name:' || err "$f 缺 name:"
  head -15 "$f" | grep -qE '^description:' || err "$f 缺 description:"
done
[ $fail -eq 0 ] && ok "全部 SKILL.md frontmatter 合法"

echo "== 3. 角色卡:文件 ↔ role-routing 字典 ↔ STATE 模板 =="
for rf in "$REF"/roles/*.md; do
  r="$(basename "$rf" .md)"
  grep -q "$r" "$REF/role-routing.md" || err "角色 '$r' 未在 role-routing.md 出现(字典/规则漏登记)"
  grep -q "$r" "$REF/templates/STATE.md" || err "角色 '$r' 未在 STATE 模板取值字典"
done
ok "角色卡交叉引用检查完成($(ls "$REF"/roles/*.md | wc -l | tr -d ' ') 个)"

echo "== 4. verify checks:文件 ↔ role-routing ↔ cap-test =="
for mf in "$ROOT"/cap-test/checks/*.md; do
  m="$(basename "$mf" .md)"
  grep -q "$m" "$REF/role-routing.md" || err "check '$m' 未在 role-routing.md"
  grep -q "$m" "$ROOT/cap-test/SKILL.md" || err "check '$m' 未被 cap-test 引用"
done
ok "verify checks 交叉引用检查完成($(ls "$ROOT"/cap-test/checks/*.md | wc -l | tr -d ' ') 个)"

echo "== 4.1 public entry vocabulary =="
grep -q '唯一公开入口' "$ROOT/cap/SKILL.md" || err "cap 未声明为唯一公开入口"
grep -q "publicSkillNames = \['cap'\]" scripts/setup-lib.mjs || err "安装器未限制为唯一公开 Skill: cap"
for internal in harvest-experience cap-flow cap-understand cap-define cap-plan cap-implement cap-test cap-review cap-release; do
  if grep -q "publicSkillNames.*$internal" scripts/setup-lib.mjs; then err "内部阶段被暴露为公开 Skill: $internal"; fi
done
for word in 项目了解 需求确认 开发计划 编码实现 测试验证 代码评审 发布上线; do
  grep -q "$word" "$ROOT/cap/SKILL.md" || err "cap 缺少公开阶段名: $word"
  grep -q "$word" "$ROOT/cap-flow/SKILL.md" || err "cap-flow 缺少公开阶段名: $word"
done
grep -q '不得要求用户调用内部技能名' "$ROOT/cap-flow/SKILL.md" || err "cap-flow 缺少内部名称隐藏纪律"
ok "公开入口与直白动作词检查完成"

echo "== 4.2 canonical stage protocol =="
for old in cap-map cap-shape cap-build cap-verify; do
  if contains_old_skill_name "$old"; then err "仍存在旧 Skill 名: $old"; fi
done
grep -q 'stage: understand | define | plan | implement | test | review | release | done' "$REF/templates/STATE.md" || err "STATE 阶段枚举未迁移"
ok "阶段协议迁移检查完成"

echo "== 4.3 progress and repository reconnaissance =="
for f in "$ROOT"/cap-{understand,define,plan,implement,test,review,release}/SKILL.md; do
  grep -q 'progress-protocol.md' "$f" || err "$f 未加载可见进度协议"
  grep -q 'task-reconnaissance.md' "$f" || err "$f 未加载任务级代码侦察协议"
done
grep -q 'task-context.md' "$ROOT/cap-flow/SKILL.md" || err "cap-flow 未要求任务级代码事实"
grep -q 'cap-context-guard' "$ROOT/cap-flow/SKILL.md" || err "cap-flow 未执行 task-context 确定性门禁"
grep -q 'cap-status.mjs' "$ROOT/cap/SKILL.md" || err "cap 未执行客户端握手与下一动作判定"
grep -q 'outbox.jsonl' "$ROOT/cap/SKILL.md" || err "cap 未声明离线 Outbox 补报协议"
grep -q '等待历史元数据补报授权' "$ROOT/cap/SKILL.md" || err "cap 未区分当前 Task 与历史 Outbox 授权边界"
grep -q '多个外部写操作必须串行' "$REF/progress-protocol.md" || err "进度协议未阻止未授权批量外部写入"
grep -q '禁止静默降级' "$ROOT/cap/SKILL.md" || err "cap 未声明平台失败禁止静默降级"
grep -q 'task_creation_blocked' "$ROOT/cap/SKILL.md" || err "cap 未对敏感 Task 创建拒绝执行单次脱敏重试与硬阻断"
grep -q 'mode=boundary_blocked' "$ROOT/cap/SKILL.md" || err "cap 未把旧 Task/分支串台作为机器硬阻断"
grep -q 'cap-task-state-switch.mjs' "$REF/progress-protocol.md" || err "进度协议未要求安全保存旧 .cap 状态后切换 Task"
grep -q '同一会话立即执行下一动作' "$ROOT/cap-flow/SKILL.md" || err "cap-flow 仍可能停在 Artifact/STATE"
grep -q 'prepare-next' "$ROOT/cap-flow/SKILL.md" || err "cap-flow 未在新需求前执行活动 Task 守卫"
grep -q '禁止递归扫描 `.cap/history`' "$ROOT/cap-flow/SKILL.md" || err "cap-flow 未限制 AI 全量读取历史需求"
grep -q 'history/<task-id>' "$REF/intake.md" || err "Retire 未切换到按 Task 的历史快照"
grep -q 'Server Gate PASS' "$REF/intake.md" || err "Retire 未要求权威 Gate 后退场"
grep -q '不得停在口头承诺' "$REF/progress-protocol.md" || err "进度协议未强制真实执行"
grep -q 'External operation boundary' "$REF/task-reconnaissance.md" || err "task-context 未记录外部操作边界"
grep -q 'External operation authorization' "$REF/templates/STATE.md" || err "STATE 未跨会话保存授权边界"
ok "进度与代码侦察协议检查完成"

echo "== 4.3.1 Harness Action 边界 =="
grep -q 'STATE 是游标' "$REF/harness-action-protocol.md" || err "Harness 协议未声明 STATE 非 Gate 真值"
grep -q 'create_task_action' "$ROOT/cap-test/SKILL.md" || err "cap-test 未接入 Test Action"
LEGACY_ACTION_PATTERN="claim""_task_action|complete""_task_action"
if grep -R -E -q -- "$LEGACY_ACTION_PATTERN" "$ROOT"; then err "Skills 仍引用旧 Task Action 协议"; fi
grep -q '客户端不得自行回写 PASS' "$REF/harness-action-protocol.md" || err "Harness 协议未禁止客户端自行回写 Test/Review PASS"
grep -q '代码修复：只续接 Server Review 生成的 Harness Patch Action' "$ROOT/cap/SKILL.md" || err "cap 入口未把 Patch 收敛到 Server Harness Action"
grep -q '同一阶段只能使用一套协议' "$REF/harness-action-protocol.md" || err "Harness 协议未禁止新旧 Action 双写"
grep -q 'Review Run 默认只读源码' "$ROOT/cap-review/SKILL.md" || err "cap-review 未落实只读执行"
if grep -q 'disposition: <auto-fix' "$ROOT/cap-review/SKILL.md"; then err "cap-review 仍暴露 auto-fix disposition"; fi
grep -q '## Harness actions' "$REF/templates/STATE.md" || err "STATE 未保存 Harness Action 引用"
grep -q '编码实现不创建或认领 Task Action' "$ROOT/harvest-experience/references/platform-task-loop.md" || err "编码实现仍未收敛到 Session + Artifact + Delivery"
grep -q 'Action 终态的本地证据同步' "$REF/harness-action-protocol.md" || err "Harness 协议未同步 STATE 与阶段报告"
grep -q '必须替换报告中已经失效的文字' "$REF/harness-action-protocol.md" || err "Harness 协议未禁止保留过期阶段报告"
grep -q 'ENV_BLOCKED.*绝不能改写为代码失败或 PASS' "$REF/harness-action-protocol.md" || err "Harness 协议未保持环境阻塞分类"
grep -q 'currentCommit/currentGate/currentAction/blocker/nextAction' "$REF/progress-protocol.md" || err "进度协议未声明 Server canonical projection"
grep -q 'Session finished ≠ Task finished' "$REF/harness-action-protocol.md" || err "Harness 协议未禁止 Session 越权完成 Task"
grep -q 'local PASS ≠ Server Gate PASS' "$REF/harness-action-protocol.md" || err "Harness 协议未禁止客户端自签 Gate"
grep -q 'harness-mode' "$REF/harness-action-protocol.md" || err "Harness 协议未区分业务仓与 local-only 维护仓"
grep -q 'repository_harness_local_only' "scripts/client-delivery.mjs" || err "候选交付脚本未硬阻断 local-only 维护仓"
grep -q 'repo + task + branch + commit' "$REF/harness-action-protocol.md" || err "Harness 协议未冻结 Push 授权身份"
grep -q '历史 Outbox 永不继承新会话的授权' "$ROOT/harvest-experience/references/platform-task-loop.md" || err "Outbox 仍可能继承历史授权"
grep -q 'authorization-fingerprint:' "$REF/templates/STATE.md" || err "STATE 未保存脱敏授权 fingerprint"
[ -f scripts/cap-local-test-provider.mjs ] || err "缺少本地 Test Provider 唤醒脚本"
grep -q 'cap-local-test-provider.mjs' "$ROOT/cap/SKILL.md" || err "cap 未唤醒本地 Test Provider"
ok "Harness Action 与独立 Gate 边界检查完成"

echo "== 4.3.2 Git 分支意图与提交范围 Gate =="
COLLAB="$REF/collaboration-discipline.md"
grep -q '## 0. 任务入口：分支意图 Gate' "$COLLAB" || err "collaboration-discipline 缺分支意图 Gate"
grep -q '### 3.1 提交范围 Gate' "$COLLAB" || err "collaboration-discipline 缺提交范围 Gate"
grep -q '## 分支意图 Gate' "$ROOT/cap-flow/SKILL.md" || err "cap-flow 未在新任务入口执行分支意图 Gate"
grep -q 'branch-purpose / base-branch / base-commit' "$ROOT/cap-implement/SKILL.md" || err "cap-implement 未校验分支意图字段"
grep -q '### 3.9 提交范围 Gate' "$ROOT/cap-implement/SKILL.md" || err "cap-implement 缺提交范围 Gate"
grep -q '## Commit scope' "$REF/templates/STATE.md" || err "STATE 未保存提交范围快照"
grep -q 'branch-purpose:' "$REF/templates/STATE.md" || err "STATE 缺 branch-purpose"
grep -q 'base-branch:' "$REF/templates/STATE.md" || err "STATE 缺 base-branch"
grep -q 'base-commit:' "$REF/templates/STATE.md" || err "STATE 缺 base-commit"
grep -q '禁止 `git add \.` / `git add -A`' "$ROOT/cap-implement/SKILL.md" || err "cap-implement 未禁止整脏区暂存"
grep -q 'branch-intent:' "$REF/runtime-adapters/codex.md" || err "Codex HANDOFF 未透传分支意图"
grep -q 'commit-scope:' "$REF/runtime-adapters/codex.md" || err "Codex HANDOFF 未透传提交范围"
grep -q 'commit-scope:' "$ROOT/cap-implement/SKILL.md" || err "cap-implement HANDOFF 未透传提交范围"
ok "Git 分支意图与提交范围 Gate 检查完成"

echo "== 4.3.3 显式本地运行模式 =="
grep -q 'mode=local_explicit' "$ROOT/cap/SKILL.md" || err "cap 未识别显式本地模式"
grep -q 'CAPITAL_AGENT_MODE=local' "$ROOT/harvest-experience/SKILL.md" || err "经验闭环未跳过显式本地模式"
grep -q 'CAPITAL_AGENT_MODE=local' scripts/setup.mjs || err "setup 未持久化显式本地模式"
grep -q 'local_explicit' scripts/cap-status.mjs || err "cap-status 未实现显式本地状态"
grep -q -- '--local' README.md || err "README 未公开本地安装命令"
ok "显式本地运行模式检查完成"

echo "== 4.4 external integration safety invariants =="
SERVER_ROLE="$REF/roles/server-dev.md"
for invariant in '环境选择 fail-closed' '配置值保持真实作用域' '真实外部调用必须显式启用' '新配置默认不产生业务流量'; do
  grep -q "$invariant" "$SERVER_ROLE" || err "server-dev 缺少外部集成不变量: $invariant"
done
grep -q 'External Integration Safety Invariants' "$ROOT/cap-implement/SKILL.md" || err "cap-implement 未加载外部集成安全不变量"
grep -q 'External Integration Safety Invariants' "$ROOT/cap-review/SKILL.md" || err "cap-review 未加载外部集成安全不变量"
for project_term in project_specific_table ProjectSpecificEnum CustomerSpecificField 'vendor-specific-code'; do
  if grep -q "$project_term" "$SERVER_ROLE"; then err "通用 server-dev 混入项目特有字段: $project_term"; fi
done
ok "外部集成安全不变量与分层检查完成"

echo "== 5. 可移植自检:流程 skill 不得硬依赖 Claude 专属工具 =="
for f in "$ROOT"/*/SKILL.md; do
  # 允许出现在"降级/不依赖"语境;这里只粗查是否完全没提降级却硬用 AskUserQuestion
  if grep -q "AskUserQuestion" "$f" && ! grep -q "text_mode" "$f"; then
    err "$f 提到 AskUserQuestion 但无 text_mode 降级(违反可移植铁律)"
  fi
done
[ $fail -eq 0 ] && ok "可移植自检通过"

echo "== 6. 语言包:文件 ↔ role-routing §7 登记 =="
if [ -d "$REF/languages" ]; then
  for lf in "$REF"/languages/*.md; do
    l="$(basename "$lf" .md)"
    grep -q "languages/$l" "$REF/role-routing.md" || err "语言包 '$l' 未在 role-routing §7 登记"
    head -6 "$lf" | grep -qE '^lang:' || err "$lf 缺 lang: frontmatter"
  done
  ok "语言包检查完成($(ls "$REF"/languages/*.md 2>/dev/null | wc -l | tr -d ' ') 个)"
fi

echo "== 7. 强门禁脚本 cap-guard 随技能自包含且可执行 =="
GUARD="$ROOT/cap-flow/scripts/cap-guard"
if [ -f "$GUARD" ]; then
  [ -x "$GUARD" ] && ok "$GUARD(存在且可执行)" || err "$GUARD 不可执行(chmod +x)"
  # hook 模板的查找路径必须指向 skills/cap-flow/scripts(三种安装方式一致)
  grep -q "skills/cap-flow/scripts/cap-guard" "$REF/templates/hooks/pre-commit" \
    || err "pre-commit hook 未按 skills/cap-flow/scripts/ 查找 cap-guard(路径漂移)"
else
  err "缺失:$GUARD(强门禁脚本应随 cap-flow 技能自包含)"
fi

echo "== 8. 开源发布安全审计 =="
node scripts/audit-open-source.mjs || err "开源发布安全审计未通过"

echo
if [ $fail -eq 0 ]; then echo "RESULT: PASS ✅"; exit 0
else echo "RESULT: $fail 项不一致 ❌(修完再 commit)"; exit 1; fi
