              },
              "environment": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "product": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "contractVersion": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "tenant",
              "project",
              "provider",
              "environment",
              "product",
              "contractVersion"
            ],
            "additionalProperties": false
          },
          "source": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "hash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "task": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "commit": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{40}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "path",
              "hash",
              "task",
              "commit"
            ],
            "additionalProperties": false
          },
          "fromId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$"
          },
          "toId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$"
          }
        },
        "required": [
