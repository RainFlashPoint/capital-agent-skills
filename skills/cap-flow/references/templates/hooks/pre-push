#!/bin/sh
# cap-flow pre-push 检查
# 作用：开发/测试分支允许先交付代码供环境验证；受保护分支仍要求 verify + review 全过。
# 纯 shell —— 不调用任何 AI、不需要任何密钥(评审由你在本地用 /cap 跑到 review 阶段，
#            它会把结论写进 .cap/STATE.md；本 hook 只核对那行结论)。
# 绕过(明知故犯)：git push --no-verify
#
# 安装：由 cap-understand 的"脚手架自检"主动询问后拷到 .git/hooks/pre-push 并 chmod +x，
#       或手动：cp 本文件 .git/hooks/pre-push && chmod +x .git/hooks/pre-push

STATE=".cap/STATE.md"
HEAD_SHA=$(git rev-parse HEAD 2>/dev/null)
SHORT=$(git rev-parse --short HEAD 2>/dev/null)
PROTECTED_BRANCHES=${CAPITAL_AGENT_PROTECTED_BRANCHES:-main,master,release,prod,production}

is_protected_branch() {
  branch=$1
  old_ifs=$IFS
  IFS=,
  for protected in $PROTECTED_BRANCHES; do
    case "$branch" in
      "$protected"|"$protected"/*) IFS=$old_ifs; return 0 ;;
    esac
  done
  IFS=$old_ifs
  return 1
}

# pre-push stdin: <local ref> <local sha> <remote ref> <remote sha>。
# 删除 ref(local sha 全 0)不需要流程门；任一目标为受保护分支时才启用完整发布门。
PROTECTED_TARGET=""
while read local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in 0000000000000000000000000000000000000000) continue ;; esac
  branch=${remote_ref#refs/heads/}
  if is_protected_branch "$branch"; then PROTECTED_TARGET=$branch; break; fi
done

if [ -z "$PROTECTED_TARGET" ]; then
  if [ -f "$STATE" ]; then
    TASK=$(grep -iE '^task-id:' "$STATE" | tail -1 | sed 's/^[^:]*:[[:space:]]*//')
    echo "✓ cap: 开发/测试分支代码交付放行 (HEAD ${SHORT}, task ${TASK:-unattached})"
    echo "  环境验证可保持 ENV_PENDING/ENV_BLOCKED；生产晋级与 Task 完成仍需完整 gate。"
  else
    echo "✓ cap: 非受保护分支代码交付放行 (HEAD ${SHORT}); 下次 /cap 将执行 Git/平台对账。"
  fi
  exit 0
fi

if [ ! -f "$STATE" ]; then
  # 无 STATE 有两种情形:① 特性已退场,history/archive 有快照=合法收尾;② 从没走过 cap 流程。
  if [ -n "$(ls -A .cap/history 2>/dev/null)" ] || [ -n "$(ls -A .cap/archive 2>/dev/null)" ]; then
    echo "✓ cap: 无在飞特性且存在历史快照 —— 放行 (HEAD ${SHORT})"
    exit 0
  fi
  echo "✗ cap: 没找到 $STATE 且无 .cap/history 或 .cap/archive —— 这些改动还没走过 cap 流程。"
  echo "  先跑 /cap 走一遍(shape→plan→build→verify→review)。"
  echo "  确实要跳过：git push --no-verify"
  exit 1
fi

# 契约：cap-review 全部通过时，会向 STATE 写入恰好一行：
#   cap-gate: PASS reviewed-head=<被评审的 commit sha>
# 未通过/被门控时写 BLOCK。本 hook 只认这行。
GATE_LINE=$(grep -iE '^cap-gate:' "$STATE" | tail -1)

case "$GATE_LINE" in
  *"PASS"*) ;;  # 继续核对 head
  *)
    echo "✗ cap: 目标 ${PROTECTED_TARGET} 是受保护分支，STATE 里没有 'cap-gate: PASS'。"
    echo "  开发/测试分支可先推送做环境验证；生产晋级仍需 /cap 完成 verify + review。"
    exit 1 ;;
esac

REVIEWED=$(printf '%s' "$GATE_LINE" | sed -n 's/.*reviewed-head=\([0-9a-f]*\).*/\1/p')
if [ -n "$REVIEWED" ] && [ "$REVIEWED" != "$HEAD_SHA" ]; then
  # HEAD 移过 reviewed-head 不一定是"又改了代码":退场归档(retire)+合并收尾会推进 HEAD 但
  # 只动 .cap/ bookkeeping。判据=reviewed-head..HEAD 间【非 .cap/ 的代码】是否真有改动。
  # 先确认 reviewed-head 是本仓有效 commit(异仓/rebase 致失效时 diff 会空,不能据此误放行)→ 失效则保守拦。
  if ! git cat-file -e "${REVIEWED}^{commit}" 2>/dev/null; then
    echo "✗ cap: reviewed-head ${REVIEWED} 不是本仓有效 commit(可能 rebase/异仓)—— 保守拦截。"
    echo "  重新跑 /cap 到 review 刷新 reviewed-head。绕过：git push --no-verify"
    exit 1
  fi
  CODE_CHANGED=$(git diff --name-only "$REVIEWED..$HEAD_SHA" -- . ':(exclude).cap' 2>/dev/null)
  if [ -z "$CODE_CHANGED" ]; then
    echo "✓ cap: 评审后仅 .cap/ 收尾变动(retire/merge),代码未变 —— 放行 (reviewed ${REVIEWED} → HEAD ${SHORT})"
    exit 0
  fi
  echo "✗ cap: 评审过的是 ${REVIEWED}，当前 HEAD 是 ${HEAD_SHA} —— 评审之后改了代码:"
  printf '    %s\n' $CODE_CHANGED
  echo "  重新跑 /cap 到 review。绕过：git push --no-verify"
  exit 1
fi

echo "✓ cap: verify + review 均通过 (HEAD ${SHORT})"
exit 0
