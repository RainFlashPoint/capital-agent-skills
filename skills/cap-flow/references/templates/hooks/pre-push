#!/bin/sh
# cap-flow pre-push 检查
# 作用：开发/测试分支允许先交付代码供环境验证；受保护分支按运行模式收紧。
# 团队模式的可信 Gate 来自 Server Action，STATE 只是可编辑游标，不能自签放行受保护分支。
# 绕过(明知故犯)：git push --no-verify
#
# 安装：运行当前包 scripts/install-git-governance.mjs；托管包装器注入包路径并保留项目原 Hook。

STATE=".cap/STATE.md"
HEAD_SHA=$(git rev-parse HEAD 2>/dev/null)
SHORT=$(git rev-parse --short HEAD 2>/dev/null)
PROTECTED_BRANCHES=${CAPITAL_AGENT_PROTECTED_BRANCHES:-main,master,release,prod,production}

is_protected_branch() {
  branch=$1
  old_ifs=$IFS
  IFS=,
  for protected in $PROTECTED_BRANCHES; do
    case "$branch" in
      "$protected"|"$protected"/*) IFS=$old_ifs; return 0 ;;
    esac
  done
  IFS=$old_ifs
  return 1
}

# pre-push stdin: <local ref> <local sha> <remote ref> <remote sha>。
# 删除 ref(local sha 全 0)不需要流程门；待推送 Commit 未跟踪原始 STATE 时须有团队交接摘要。
PROTECTED_TARGET=""
while read local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in 0000000000000000000000000000000000000000) continue ;; esac
  branch=${remote_ref#refs/heads/}
  local_branch=${local_ref#refs/heads/}
  if [ "$local_branch" = "$local_ref" ]; then local_branch=$(git symbolic-ref -q --short HEAD 2>/dev/null || true); fi
  CODE_DELIVERY=""
  if [ "$branch" != "$remote_ref" ] && ! is_protected_branch "$branch" && ! git cat-file -e "${local_sha}:.cap/STATE.md" 2>/dev/null; then
    BASE_REF=""
    if [ "$remote_sha" != "0000000000000000000000000000000000000000" ]; then
      if ! git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
        echo "✗ cap: 远端基线 ${remote_sha} 尚未在本机获取；先 fetch 目标分支，再重试推送。" >&2
        exit 1
      fi
      BASE_REF=$remote_sha
    fi
    if [ -z "$BASE_REF" ]; then
      DEFAULT_REF=$(git symbolic-ref -q refs/remotes/origin/HEAD 2>/dev/null || true)
      if [ -z "$DEFAULT_REF" ]; then
        for candidate in refs/heads/main refs/heads/master refs/remotes/origin/main refs/remotes/origin/master; do
          if git rev-parse --verify -q "$candidate^{commit}" >/dev/null 2>&1; then DEFAULT_REF=$candidate; break; fi
        done
      fi
      if [ -z "$DEFAULT_REF" ]; then echo "✗ cap: 无法确定新分支的代码基线，不能核验团队交接范围。" >&2; exit 1; fi
      BASE_REF=$(git merge-base "$DEFAULT_REF" "$local_sha" 2>/dev/null || true)
      if [ -z "$BASE_REF" ]; then echo "✗ cap: 待推送 Commit 与默认主干无共同基线。" >&2; exit 1; fi
    fi
    CODE_DELIVERY=$(git diff --name-only "$BASE_REF" "$local_sha" -- . ':(exclude).cap' 2>/dev/null) || exit 1
  fi
  if [ -n "$CODE_DELIVERY" ]; then
    HOOK_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
    PACKAGE_ROOT=${CAPITAL_AGENT_PACKAGE_ROOT:-}
    if [ -z "$PACKAGE_ROOT" ] && [ -f "$HOOK_DIR/../scripts/cap-team-handoff.mjs" ]; then PACKAGE_ROOT="$HOOK_DIR/.."; fi
    if [ -z "$PACKAGE_ROOT" ] || [ ! -f "$PACKAGE_ROOT/scripts/cap-team-handoff.mjs" ]; then
      echo "✗ cap: 缺少团队交接验证器；请用当前 cap 包重新安装 Git governance。" >&2
      exit 1
    fi
    if [ -z "$local_branch" ] || ! node "$PACKAGE_ROOT/scripts/cap-team-handoff.mjs" verify . --ref "$local_sha" --branch "$local_branch"; then
      echo "✗ cap: 开发分支必须先提交已审阅的 .cap/HANDOFF.md；摘要须绑定精确代码 Commit 与 Git tree。" >&2
      exit 1
    fi
  fi
  if is_protected_branch "$branch"; then PROTECTED_TARGET=$branch; fi
done

if [ -z "$PROTECTED_TARGET" ]; then
  if [ -f "$STATE" ]; then
    TASK=$(grep -iE '^task-id:' "$STATE" | tail -1 | sed 's/^[^:]*:[[:space:]]*//')
    echo "✓ cap: 开发/测试分支代码交付放行 (HEAD ${SHORT}, task ${TASK:-unattached})"
    echo "  环境验证可保持 ENV_PENDING/ENV_BLOCKED；生产晋级与 Task 完成仍需完整 gate。"
  else
    echo "✓ cap: 非受保护分支代码交付放行 (HEAD ${SHORT}); 下次 /cap 将执行 Git/平台对账。"
  fi
  exit 0
fi

CONFIG_MODE=$(sed -n 's/^CAPITAL_AGENT_MODE=//p' "${HOME:-}/.config/capital-agent/env" 2>/dev/null | tail -1)
EFFECTIVE_MODE=${CAPITAL_AGENT_MODE:-$CONFIG_MODE}
HARNESS_MODE=$(sed -n 's/^harness-mode:[[:space:]]*//p' .cap/PROFILE.md 2>/dev/null | tail -1 | tr '[:upper:]' '[:lower:]')
if [ "$EFFECTIVE_MODE" != "local" ] && [ "$HARNESS_MODE" != "local-only" ]; then
  echo "✗ cap: 目标 ${PROTECTED_TARGET} 是受保护分支；团队模式禁止用可编辑 STATE 自证 Server Gate。"
  echo "  请推送研发分支，由绑定精确 Action ID 与 Commit 的 Server Gate 完成晋级。"
  exit 1
fi

if [ ! -f "$STATE" ]; then
  # 无 STATE 有两种情形:① 特性已退场,history/archive 有快照=合法收尾;② 从没走过 cap 流程。
  if [ -n "$(ls -A .cap/history 2>/dev/null)" ] || [ -n "$(ls -A .cap/archive 2>/dev/null)" ]; then
    echo "✓ cap: 无在飞特性且存在历史快照 —— 放行 (HEAD ${SHORT})"
    exit 0
  fi
  echo "✗ cap: 没找到 $STATE 且无 .cap/history 或 .cap/archive —— 这些改动还没走过 cap 流程。"
  echo "  先跑 /cap 走一遍(shape→plan→build→verify→review)。"
  echo "  确实要跳过：git push --no-verify"
  exit 1
fi

# 本地显式模式 / local-only 维护仓契约：cap-review 全部通过时，会向 STATE 写入恰好一行：
#   cap-gate: PASS reviewed-head=<被评审的 commit sha>
# 未通过/被门控时写 BLOCK。本 hook 只认这行。
GATE_LINE=$(grep -iE '^cap-gate:' "$STATE" | tail -1)

case "$GATE_LINE" in
  *"PASS"*) ;;  # 继续核对 head
  *)
    echo "✗ cap: 目标 ${PROTECTED_TARGET} 是受保护分支，STATE 里没有 'cap-gate: PASS'。"
    echo "  开发/测试分支可先推送做环境验证；生产晋级仍需 /cap 完成 verify + review。"
    exit 1 ;;
esac

REVIEWED=$(printf '%s' "$GATE_LINE" | sed -n 's/.*reviewed-head=\([0-9a-f]*\).*/\1/p')
if [ -n "$REVIEWED" ] && [ "$REVIEWED" != "$HEAD_SHA" ]; then
  # HEAD 移过 reviewed-head 不一定是"又改了代码":退场归档(retire)+合并收尾会推进 HEAD 但
  # 只动 .cap/ bookkeeping。判据=reviewed-head..HEAD 间【非 .cap/ 的代码】是否真有改动。
  # 先确认 reviewed-head 是本仓有效 commit(异仓/rebase 致失效时 diff 会空,不能据此误放行)→ 失效则保守拦。
  if ! git cat-file -e "${REVIEWED}^{commit}" 2>/dev/null; then
    echo "✗ cap: reviewed-head ${REVIEWED} 不是本仓有效 commit(可能 rebase/异仓)—— 保守拦截。"
    echo "  重新跑 /cap 到 review 刷新 reviewed-head。绕过：git push --no-verify"
    exit 1
  fi
  CODE_CHANGED=$(git diff --name-only "$REVIEWED..$HEAD_SHA" -- . ':(exclude).cap' 2>/dev/null)
  if [ -z "$CODE_CHANGED" ]; then
    echo "✓ cap: 评审后仅 .cap/ 收尾变动(retire/merge),代码未变 —— 放行 (reviewed ${REVIEWED} → HEAD ${SHORT})"
    exit 0
  fi
  echo "✗ cap: 评审过的是 ${REVIEWED}，当前 HEAD 是 ${HEAD_SHA} —— 评审之后改了代码:"
  printf '    %s\n' $CODE_CHANGED
  echo "  重新跑 /cap 到 review。绕过：git push --no-verify"
  exit 1
fi

echo "✓ cap: verify + review 均通过 (HEAD ${SHORT})"
exit 0
