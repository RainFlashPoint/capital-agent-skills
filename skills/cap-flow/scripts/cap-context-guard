#!/usr/bin/env bash
set -eu
# The portable Node guard owns validation and aggregated diagnostics on all hosts.
repo_candidate="${CAP_REPO_ROOT:-.}"
expected_intent=""
stage=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --intent) expected_intent="${2:-}"; shift 2 ;;
    --stage) stage="${2:-}"; shift 2 ;;
    *) repo_candidate="$1"; shift ;;
  esac
done
script_dir="$(cd "$(dirname "$0")" && pwd -P)"
package_root="$(cd "$script_dir/../../.." && pwd -P)"
exec node "$package_root/scripts/cap-runtime.mjs" context "$repo_candidate" --stage "$stage" --intent "$expected_intent"
